# Database (PostgreSQL - use Supabase for deployment)
DATABASE_URL=postgresql://postgres:password@localhost:5432/voting_system

# Frontend API URL
# Defaults to /api which is proxied by Astro dev (→ localhost:3001) or Netlify functions.
# For local dev against Express on port 3001, you can use the proxy default:
PUBLIC_API_URL=/api
# Or point directly at the backend (note: backend routes are mounted under /api):
# PUBLIC_API_URL=http://localhost:3001/api
