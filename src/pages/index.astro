      </div>

      <img src="/images/wf-ui-highlight-effect.avif" alt="" class="corner-icon-bottom" aria-hidden="true" />
      <div id="role-tooltip" class="role-tooltip"></div>
    </div>

  </main>

  <Footer />

</BaseLayout>

<script>
  import { setSessionEmail, setSessionName, getSessionEmail, validateInstitutionalEmail } from "../lib/auth";
  import { verifyStudentEmail } from "../lib/api";

  function init() {
    const gateEl = document.getElementById("email-gate")!;
    const appEl  = document.getElementById("app-content")!;

    // Already logged in?
    const email = getSessionEmail();
    if (email) {
      gateEl.style.display = "none";
      appEl.style.display   = "block";
      bindRoleCards();
      return;
    }

    // Gate form handler
    const form  = document.getElementById("gate-form") as HTMLFormElement;
    const input = document.getElementById("gate-email") as HTMLInputElement;
    const error = document.getElementById("gate-error")!;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      error.textContent = "";

      // 1. Validate format / domain
      const result = validateInstitutionalEmail(input.value);
      if (!result.valid) {
        error.textContent = result.error ?? "Invalid email.";
        return;
      }

      // 2. Check against Students table
      let studentName = "";
      try {
        const res = await verifyStudentEmail(input.value);
        if (!res.exists) {
          error.textContent = "This email is not registered in the voter list.";
          return;
        }
        studentName = res.student?.name || input.value.split("@")[0];
      } catch {
        error.textContent = "Unable to verify email. Please try again.";
        return;
      }

      setSessionEmail(input.value);
      setSessionName(studentName);
      window.location.reload();
    });
  }

  const responsibilities: Record<string, string> = {
    "Strategy Coordinator": "Develop the annual roadmap, monitor community goals, track performance, and ensure all initiatives align with the community's vision and mission.",
    "Industry Relations": "Build relationships with faculty, alumni, industry professionals, and external communities. Coordinate guest lectures, partnerships, and networking opportunities.",
    "Executive Coordinator": "Support executive meetings, coordinate with all leadership teams, follow up on decisions, and ensure smooth execution of strategic initiatives.",
    "Operations Coordinator": "Manage daily operations, coordinate inter-team activities, monitor task completion, and ensure events and projects are executed on time.",
    "Project Coordinator": "Oversee technical and community projects, assign responsibilities, monitor milestones, and maintain project documentation.",
    "Resource Coordinator": "Manage event logistics, lab resources, budgets, inventory, and operational requirements for community activities.",
    "Administration Coordinator": "Manage official records, attendance, member registration, and administrative activities.",
    "Documentation Coordinator": "Prepare meeting minutes, reports, proposals, newsletters, and maintain the community knowledge repository.",
    "Communication Coordinator": "Handle official announcements, email communications, notices, and internal coordination between members and leadership.",
    "Learning Coordinator": "Organize technical workshops, bootcamps, certification sessions, and mentoring programs.",
    "Project Coordinator (Tech)": "Lead application development, hackathons, innovation challenges, and technical collaboration among members.",
    "AI & Automation Coordinator": "Drive AI initiatives, workflow automation, research on emerging technologies, and platform innovation.",
    "Events Coordinator": "Plan and execute workshops, seminars, competitions, community meetups, and flagship events.",
    "Engagement Coordinator": "Increase member participation, manage social media, run campaigns, recruit volunteers, and strengthen community engagement.",
    "Partnership Coordinator": "Coordinate collaborations with student clubs, alumni, faculty, and industry organizations while expanding the community network.",
    "Creative Design Coordinator": "Design posters, banners, certificates, presentations, and all visual assets for community initiatives.",
    "Media Production Coordinator": "Capture and edit event photography, videography, promotional videos, and highlight reels.",
    "Branding Coordinator": "Maintain the community's brand identity, content standards, creative templates, and visual consistency across all platforms.",
  };

  function bindRoleCards() {
    const tip = document.getElementById("role-tooltip")!;

    // Click handler for role cards — navigate directly to supporting-role page
    document.querySelectorAll(".role-card").forEach((el) => {
      const card = (el as HTMLElement).closest(".candidate-card") as HTMLElement;
      if (!card || card.classList.contains("disabled")) return;

      el.addEventListener("click", (e) => {
        e.preventDefault();
        const execId = card.getAttribute("data-exec-id");
        const roleTitle = el.querySelector(".role-title")?.textContent ?? "";
        if (execId && roleTitle) {
          window.location.href = `/supporting-role?exec=${encodeURIComponent(execId)}&role=${encodeURIComponent(roleTitle)}`;
        }
      });

      el.addEventListener("mouseenter", (e) => {
        const title = (el as HTMLElement).querySelector(".role-title")?.textContent ?? "";
        const desc = responsibilities[title];
        if (!desc) { tip.style.display = "none"; return; }
        tip.textContent = desc;
        const rect = (el as HTMLElement).getBoundingClientRect();
        tip.style.left = rect.left + "px";
        tip.style.top = (rect.bottom + 8) + "px";
        tip.style.display = "block";
      });

      el.addEventListener("mouseleave", () => {
        tip.style.display = "none";
      });
    });
  }

  init();
</script>

<style>
  /* ── Page wrapper ──────────────────────────────────────────── */
  #main-content {
    position: relative;
    z-index: 1;
    min-height: 80vh;
    padding: 3rem 1.5rem;
  }

  .page-wrapper {
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
  }

  .corner-icon {
    position: absolute;
    top: -1rem;
    left: -1rem;
    width: 8rem;
    height: 8rem;
    object-fit: contain;
    opacity: 0.85;
    pointer-events: none;
    z-index: -1;
  }

  .corner-icon-top-right {
    position: absolute;
    top: -1rem;
    right: -1rem;
    width: 7rem;
    height: 7rem;
    object-fit: contain;
    opacity: 0.85;
    pointer-events: none;
    z-index: -1;
  }

  .corner-icon-bottom {
    position: absolute;
    bottom: -1rem;
    right: 0;
    width: 4rem;
    height: 4rem;
    object-fit: contain;
    opacity: 0.6;
    pointer-events: none;
  }

  .watermark {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 800px;
    max-width: 90vw;
    opacity: 0.08;
    pointer-events: none;
    z-index: 0;
    user-select: none;
  }

  .page-title {
    text-align: center;
    color: var(--text-secondary);
    font-size: 0.85rem;
    margin-bottom: 2rem;
  }

  .page-title strong {
    display: block;
    color: var(--text-primary);
    font-size: 1.3rem;
    font-weight: 800;
    margin-bottom: 0.4rem;
  }

  /* ── Email Gate ────────────────────────────────────────────── */
  .gate-overlay {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(10, 17, 24, 0.75);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: 1.5rem;
  }

  .gate-card {
    max-width: 420px;
    width: 100%;
    padding: 2.5rem 2rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    animation: fadeUp 0.5s ease forwards;
  }

  .gate-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    margin-bottom: 0.25rem;
  }

  .gate-logo-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: linear-gradient(135deg, var(--accent) 0%, #6d28d9 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
