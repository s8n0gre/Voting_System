        </article>

        <article class="candidate-card glass-card" data-exec-id="4" data-exec-name="Yuvaraj E">
          <div class="card-header">
            <span class="badge">Technical Lead</span>
          </div>
          <div class="card-profile">
          <div class="avatar-wrap">
            <img src="/images/yuvaraj.jpg" alt="Yuvaraj E" class="avatar-img" />
          </div>
          <h2 class="candidate-name">Yuvaraj E</h2>
          </div>
          <div class="supporting-roles-section">
            <p class="supporting-roles-label">Co-ordinators</p>
            <ul class="supporting-roles-row">
              <li><a href="#" class="role-card"><svg class="role-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg><span class="role-title">Learning Coordinator</span></a></li>
              <li><a href="#" class="role-card"><svg class="role-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg><span class="role-title">Project Coordinator (Tech)</span></a></li>
              <li><a href="#" class="role-card"><svg class="role-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg><span class="role-title">AI & Automation Coordinator</span></a></li>
            </ul>
          </div>
        </article>

        <article class="candidate-card glass-card disabled" data-exec-id="5" data-exec-name="Mohan K">
          <div class="card-header">
            <span class="badge">Community Lead</span>
            <span class="lock-badge"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg> Locked</span>
          </div>
          <div class="card-profile">
            <div class="avatar-wrap">
              <div class="avatar-initials">MK</div>
            </div>
            <h2 class="candidate-name">Mohan K</h2>
          </div>
          <div class="supporting-roles-section">
            <p class="supporting-roles-label">Co-ordinators</p>
            <ul class="supporting-roles-row">
              <li><a href="#" class="role-card"><svg class="role-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg><span class="role-title">Events Coordinator</span></a></li>
              <li><a href="#" class="role-card"><svg class="role-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg><span class="role-title">Engagement Coordinator</span></a></li>
              <li><a href="#" class="role-card"><svg class="role-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg><span class="role-title">Partnership Coordinator</span></a></li>
            </ul>
          </div>
        </article>

        <article class="candidate-card glass-card" data-exec-id="6" data-exec-name="Navaneetha Krishnan C">
          <div class="card-header">
            <span class="badge">Creative & Media Lead</span>
          </div>
          <div class="card-profile">
          <div class="avatar-wrap">
            <img src="/images/navaneetha_krishnan.jpg" alt="Navaneetha Krishnan C" class="avatar-img" />
          </div>
          <h2 class="candidate-name">Navaneetha Krishnan C</h2>
          </div>
          <div class="supporting-roles-section">
            <p class="supporting-roles-label">Co-ordinators</p>
            <ul class="supporting-roles-row">
              <li><a href="#" class="role-card"><svg class="role-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg><span class="role-title">Creative Design Coordinator</span></a></li>
              <li><a href="#" class="role-card"><svg class="role-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg><span class="role-title">Media Production Coordinator</span></a></li>
              <li><a href="#" class="role-card"><svg class="role-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg><span class="role-title">Branding Coordinator</span></a></li>
            </ul>
          </div>
