---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Toast } from "../components/Toast";
---

<BaseLayout title="Create Account" description="Register with your institutional email to vote for the SNOW Campus Community elections">
  <Toast client:load />

  <main id="main-content">
    <div class="gate-page">
      <div class="gate-card glass-card">
        <div class="gate-logo">
          <div class="gate-logo-icon" aria-hidden="true">
            <img src="/snow-logo.png" alt="" class="gate-logo-img" />
          </div>
          <span class="gate-logo-text">SNOW</span>
        </div>
        <h1 class="gate-title">Create Your Account</h1>
        <p class="gate-subtitle">Register with your institutional email to vote for the 2026 - 2027 coordinators. Only emails in the official student list can register.</p>
        <form id="gate-form" class="gate-form" novalidate>
          <label for="gate-email" class="gate-label">Institutional Email</label>
          <input
            id="gate-email"
            class="input-field"
            type="email"
            placeholder="you@kce.ac.in"
            required
            autocomplete="email"
            autofocus
          />
          <label for="gate-password" class="gate-label">Password</label>
          <input
            id="gate-password"
            class="input-field"
            type="password"
            placeholder="At least 6 characters"
            required
            autocomplete="new-password"
          />
          <label for="gate-confirm" class="gate-label">Confirm Password</label>
          <input
            id="gate-confirm"
            class="input-field"
            type="password"
            placeholder="Re-enter your password"
            required
            autocomplete="new-password"
          />
          <p id="gate-error" class="gate-error" role="alert"></p>
          <button type="submit" class="btn-primary gate-submit">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9 11l3 3L22 4"/>
              <path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/>
            </svg>
            Create Account
          </button>
        </form>
        <p class="gate-note">
          Already have an account? <a href="/login" class="gate-link">Sign in here</a>
        </p>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  import { getSessionEmail, validateInstitutionalEmail, validatePassword, validatePasswordMatch } from "../lib/auth";
  import { verifyStudentEmail, registerUser } from "../lib/api";

  const sessionEmail = getSessionEmail();
  if (sessionEmail) {
    window.location.href = "/";
  }

  const form  = document.getElementById("gate-form") as HTMLFormElement;
  const email = document.getElementById("gate-email") as HTMLInputElement;
  const password = document.getElementById("gate-password") as HTMLInputElement;
  const confirm = document.getElementById("gate-confirm") as HTMLInputElement;
  const error = document.getElementById("gate-error")!;

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    error.textContent = "";
    const submitBtn = form.querySelector(".gate-submit")!;
    submitBtn.setAttribute("disabled", "true");

    const emailCheck = validateInstitutionalEmail(email.value);
    if (!emailCheck.valid) {
      error.textContent = emailCheck.error ?? "Invalid email.";
      submitBtn.removeAttribute("disabled");
      return;
    }

    const passCheck = validatePassword(password.value);
    if (!passCheck.valid) {
      error.textContent = passCheck.error ?? "Invalid password.";
      submitBtn.removeAttribute("disabled");
      return;
    }

    if (!validatePasswordMatch(password.value, confirm.value)) {
      error.textContent = "Passwords do not match.";
      submitBtn.removeAttribute("disabled");
      return;
    }

    try {
      const res = await verifyStudentEmail(email.value);
      if (!res.exists) {
        error.textContent = "This email is not in the registered student list. Please use your official college email.";
        submitBtn.removeAttribute("disabled");
        return;
      }

      await registerUser(email.value, password.value);
      window.location.href = "/login?registered=1";
    } catch (err) {
      error.textContent = err instanceof Error ? err.message : "Unable to register. Please try again.";
      submitBtn.removeAttribute("disabled");
    }
  });
</script>

<style>
  .gate-page {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1.5rem;
  }

  .gate-card {
    max-width: 420px;
    width: 100%;
    padding: 2.5rem 2rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    animation: fadeUp 0.5s ease forwards;
  }

  .gate-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    margin-bottom: 0.25rem;
  }

  .gate-logo-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: linear-gradient(135deg, var(--accent) 0%, #6d28d9 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .gate-logo-img {
    width: 28px;
    height: 28px;
    object-fit: contain;
    filter: drop-shadow(0 2px 10px rgba(108, 211, 54, 0.4));
  }

  .gate-logo-text {
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    background: linear-gradient(135deg, var(--accent-light) 0%, #c4b5fd 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .gate-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
    letter-spacing: -0.02em;
  }

  .gate-subtitle {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .gate-form {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-align: left;
    margin-top: 0.5rem;
  }

  .gate-label {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-secondary);
    letter-spacing: 0.03em;
  }

  .gate-error {
    min-height: 1.25rem;
    font-size: 0.8rem;
    color: #fb7185;
    margin: 0;
  }

  .gate-submit {
    justify-content: center;
    padding: 0.75rem 1.5rem;
    font-size: 0.95rem;
    margin-top: 0.25rem;
  }

  .gate-note {
    font-size: 0.78rem;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.5;
  }

  .gate-link {
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
  }
  .gate-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 480px) {
    .gate-page { padding: 1.5rem 1rem; }
    .gate-card { padding: 2rem 1.25rem; }
    .gate-title { font-size: 1.1rem; }
  }
</style>
