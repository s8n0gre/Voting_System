---
// SupportingRoleCard.astro — clickable rectangular card linking to the role detail page
import type { SupportingRole } from "../lib/api";

export interface Props {
  role: SupportingRole;
  candidateId: number;
}

const { role, candidateId } = Astro.props;
---

<a
  href={`/supporting-role?id=${role.id}&exec=${candidateId}`}
  class="role-card"
  aria-label={`View details for supporting role: ${role.title}`}
>
  <svg
    class="role-icon"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/>
    <circle cx="9" cy="7" r="4"/>
    <path d="M23 21v-2a4 4 0 00-3-3.87"/>
    <path d="M16 3.13a4 4 0 010 7.75"/>
  </svg>
  <span class="role-title">{role.title}</span>
</a>

<style>
  .role-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.875rem 0.625rem;
    background: var(--glass-bg);
    border: 1px solid var(--border-color);
    border-radius: 0.75rem;
    text-decoration: none;
    text-align: center;
    transition: all 0.2s ease;
    width: 100%;
    aspect-ratio: 4 / 3;
  }

  .role-card:hover {
    background: var(--accent-glow);
    border-color: var(--border-hover);
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.25);
  }

  .role-icon {
    color: var(--text-muted);
    opacity: 0.6;
    flex-shrink: 0;
    transition: all 0.2s ease;
  }

  .role-card:hover .role-icon {
    color: var(--accent-light);
    opacity: 1;
  }

  .role-title {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-secondary);
    transition: color 0.2s ease;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .role-card:hover .role-title { color: var(--accent-light); }
</style>
