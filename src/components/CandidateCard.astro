---
// CandidateCard.astro
import SupportingRoleCard from "./SupportingRoleCard.astro";
import type { ExecutiveCandidate } from "../lib/api";

export interface Props {
  candidate: ExecutiveCandidate;
  hasVoted?: boolean;
}

const { candidate, hasVoted = false } = Astro.props;

const initials = candidate.name
  .split(" ")
  .map((n) => n[0])
  .join("")
  .toUpperCase()
  .slice(0, 2);
---

<article
  class="candidate-card glass-card"
  data-candidate-id={candidate.id}
  aria-label={`Candidate: ${candidate.name}, running for ${candidate.role}`}
>
  <!-- Role Badge -->
  <div class="card-header">
    <span class="badge">{candidate.role}</span>
  </div>

  <!-- Profile -->
  <div class="card-profile">
    <div class="avatar-wrap">
      {
        candidate.profileImage ? (
          <img
            src={candidate.profileImage}
            alt={`Profile photo of ${candidate.name}`}
            class="avatar-img"
            loading="lazy"
            width="96"
            height="96"
          />
        ) : (
          <div class="avatar-initials" aria-hidden="true">{initials}</div>
        )
      }
      <div class="avatar-glow" aria-hidden="true"></div>
    </div>
    <h2 class="candidate-name">{candidate.name}</h2>
  </div>

  <!-- Supporting Roles -->
  {
    candidate.supportingRoles && candidate.supportingRoles.length > 0 && (
      <div class="supporting-roles-section">
        <p class="supporting-roles-label">Supporting Roles</p>
        <ul class="supporting-roles-row" role="list">
          {candidate.supportingRoles.map((role) => (
            <li>
              <SupportingRoleCard role={role} candidateId={candidate.id} />
            </li>
          ))}
        </ul>
      </div>
    )
  }

  <!-- Vote Button -->
  <div class="card-footer">
    {
      hasVoted ? (
        <div class="voted-indicator" role="status" aria-live="polite">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          You have already voted
        </div>
      ) : (
        <a
          href={`/supporting-role?id=${candidate.supportingRoles?.[0]?.id ?? candidate.id}&exec=${candidate.id}`}
          class="btn-primary card-vote-btn"
          data-vote-btn={candidate.id}
          id={`vote-btn-${candidate.id}`}
          role="button"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 11l3 3L22 4"/>
            <path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/>
          </svg>
          Vote for {candidate.name.split(" ")[0]}
        </a>
      )
    }
  </div>
</article>

<style>
  .candidate-card {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.5rem;
    position: relative;
    overflow: hidden;
  }

  .candidate-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .candidate-card:hover::before { opacity: 1; }

  .card-header {
    display: flex;
    justify-content: flex-start;
  }

  .card-profile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.875rem;
    text-align: center;
  }

  .avatar-wrap {
    position: relative;
    width: 96px;
    height: 96px;
  }

  .avatar-img {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--border-color);
    transition: border-color 0.25s ease;
  }
  .candidate-card:hover .avatar-img { border-color: var(--accent); }

  .avatar-initials {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--accent) 0%, #6d28d9 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    font-weight: 800;
    color: white;
    letter-spacing: 0.05em;
    border: 2px solid rgba(255,255,255,0.1);
  }

  .avatar-glow {
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--accent-glow) 0%, transparent 70%);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }
  .candidate-card:hover .avatar-glow { opacity: 1; }

  .candidate-name {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }

  .supporting-roles-section { border-top: 1px solid var(--border-color); padding-top: 1rem; }

  .supporting-roles-label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 0.6rem 0;
  }

  .supporting-roles-row {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.625rem;
  }

  .supporting-roles-row li {
    display: flex;
  }

  @media (max-width: 380px) {
    .supporting-roles-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .card-footer {
    margin-top: auto;
    padding-top: 0.5rem;
    border-top: 1px solid var(--border-color);
  }

  .card-vote-btn {
    width: 100%;
    justify-content: center;
  }

  .voted-indicator {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.6rem 1rem;
    background: rgba(34, 197, 94, 0.1);
    border: 1px solid rgba(34, 197, 94, 0.2);
    border-radius: 0.625rem;
    color: #4ade80;
    font-size: 0.85rem;
    font-weight: 600;
  }
</style>
