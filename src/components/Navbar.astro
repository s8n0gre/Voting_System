---
// Navbar.astro
---

<header class="navbar" role="banner">
  <div class="navbar-inner">
    <!-- Logo / Brand -->
    <a href="/" class="navbar-brand" aria-label="SNOW Campus Community home">
      <div class="navbar-logo" aria-hidden="true">
        <img src="/snow-logo.png" alt="SNOW Campus Community Logo" class="brand-logo-img" />
      </div>
      <div class="navbar-brand-text">
        <span class="brand-name">SNOW</span>
        <span class="brand-sub">Campus Community</span>
      </div>
    </a>

    <!-- Nav Actions -->
    <nav class="navbar-actions" aria-label="Site navigation">
      <a href="/" class="nav-link" id="nav-home" style="display:none">Home</a>

      <!-- Theme Toggle -->
      <button
        data-theme-toggle
        class="theme-btn"
        aria-label="Toggle dark/light mode"
        id="theme-toggle-btn"
        type="button"
      >
        <span class="theme-icon theme-icon-dark" aria-hidden="true">
          <!-- Moon -->
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </span>
        <span class="theme-icon theme-icon-light" aria-hidden="true">
          <!-- Sun -->
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="5"/>
            <line x1="12" y1="1" x2="12" y2="3"/>
            <line x1="12" y1="21" x2="12" y2="23"/>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
            <line x1="1" y1="12" x2="3" y2="12"/>
            <line x1="21" y1="12" x2="23" y2="12"/>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
          </svg>
        </span>
      </button>

      <!-- Session profile -->
      <div class="session-profile" id="session-profile" style="display:none;">
        <div class="profile-avatar" id="profile-avatar">
          <div class="profile-gif" id="profile-gif-img" role="img" aria-label="Profile"></div>
          <div class="profile-tooltip" id="profile-tooltip">
            <span class="tooltip-name" id="tooltip-name"></span>
            <span class="tooltip-email" id="tooltip-email"></span>
          </div>
        </div>
      </div>
    </nav>
  </div>
</header>

<script>
  import { getSessionEmail, getSessionName, clearSession } from "../lib/auth";

  function initNavbar() {
    const profile = document.getElementById("session-profile");
    const tooltip = document.getElementById("profile-tooltip");
    const nameEl = document.getElementById("tooltip-name");
    const emailEl = document.getElementById("tooltip-email");
    const email = getSessionEmail();
    const name = getSessionName();

    if (email && profile && tooltip && nameEl && emailEl) {
      profile.style.display = "flex";
      nameEl.textContent = name || email.split("@")[0];
      emailEl.textContent = email;
    }
  }

  initNavbar();
</script>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--nav-bg);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 2px solid var(--accent);
    transition: background 0.3s ease;
  }

  .navbar-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0.875rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .navbar-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .navbar-brand:hover { opacity: 0.85; }

  .navbar-logo {
    flex-shrink: 0;
  }

  .brand-logo-img {
    width: 38px;
    height: 38px;
    object-fit: contain;
    filter: drop-shadow(0 2px 10px rgba(108, 211, 54, 0.4));
  }

  .navbar-brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .brand-name {
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--text-primary);
  }

  .brand-sub {
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--text-muted);
    letter-spacing: 0.03em;
    margin-top: 1px;
  }

  .navbar-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .nav-link {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    padding: 0.35rem 0.75rem;
    border-radius: 0.5rem;
    transition: all 0.2s ease;
  }
  .nav-link:hover {
    color: var(--accent-light);
    background: var(--accent-glow);
  }

  .theme-btn {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: 1px solid var(--border-color);
    background: var(--glass-bg);
    color: var(--text-secondary);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    flex-shrink: 0;
  }
  .theme-btn:hover {
    border-color: var(--border-hover);
    color: var(--accent-light);
    background: var(--accent-glow);
  }

  /* Show correct icon based on theme */
  .theme-icon-dark  { display: block; }
  .theme-icon-light { display: none;  }

  [data-theme="light"] .theme-icon-dark  { display: none;  }
  [data-theme="light"] .theme-icon-light { display: block; }

  [data-theme="light"] .navbar {
    background: rgba(10, 17, 24, 0.85);
  }
  [data-theme="light"] .navbar .brand-name,
  [data-theme="light"] .navbar .nav-link,
  [data-theme="light"] .navbar .theme-btn {
    color: #94a3b8;
  }
  [data-theme="light"] .navbar .brand-sub {
    color: #f8fafc;
  }

  .session-profile {
    display: flex;
    align-items: center;
  }

  .profile-avatar {
    position: relative;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    overflow: hidden;
    cursor: pointer;
    flex-shrink: 0;
  }

  .profile-gif {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background-image: url('/images/Servicenow-Logo.gif');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .profile-tooltip {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    right: auto;
    left: -80px;
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 0.5rem;
    padding: 0.5rem 0.85rem;
    font-size: 0.78rem;
    color: var(--text-primary);
    white-space: nowrap;
    box-shadow: 0 8px 24px rgba(0,0,0,0.3);
    z-index: 200;
    pointer-events: none;
    display: none;
    flex-direction: column;
    gap: 2px;
  }

  .profile-avatar:hover .profile-tooltip {
    display: flex;
  }

  .tooltip-name {
    font-weight: 600;
    color: var(--accent);
  }

  .tooltip-email {
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  @media (max-width: 480px) {
    .brand-sub { display: none; }
    .nav-link  { display: none; }
    .session-profile { display: none !important; }
  }
</style>
